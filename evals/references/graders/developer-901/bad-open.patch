+from app.services.counter_store import CounterStore, CounterStoreError
 from app.services.passwords import verify_password
 from app.services.users import User, UserRepository
 
 logger = logging.getLogger(__name__)
 
 
+class AccountLockedError(Exception):
+    """Raised while too many recent failed logins lock an email address."""
+
+    def __init__(self, retry_after: int) -> None:
+        super().__init__(f"email address locked for {retry_after} seconds")
+        self.retry_after = retry_after
+
+
+def _failures_key(email: str, client_ip: str) -> str:
+    return f"login-failures:{email.strip().lower()}:{client_ip}"
+
+
 def authenticate_user(
     email: str,
     password: str,
@@ -16,10 +28,30 @@ def authenticate_user(
     client_ip: str,
     users: UserRepository,
     store: CounterStore,
+    lockout_threshold: int = 5,
+    lockout_seconds: int = 900,
 ) -> User | None:
-    """Return the user whose password matches, or None for rejected credentials."""
+    """Return the user for a correct email and password, otherwise None.
+
+    Raises AccountLockedError while the email address is locked.
+    """
+    key = _failures_key(email, client_ip)
+    try:
+        locked = store.get(key) >= lockout_threshold
+    except CounterStoreError:
+        # Keep logins available while the store is down.
+        logger.warning("lockout check failed; allowing the attempt")
+        locked = False
+    if locked:
+        remaining = store.ttl(key)
+        raise AccountLockedError(remaining if remaining > 0 else lockout_seconds)
     user = users.get_by_email(email)
     if user is None or not verify_password(password, user.password_hash):
-        logger.info("Failed login for %s from %s", email, client_ip)
+        logger.info("login failed for %s from %s", email, client_ip)
+        try:
+            if store.incr(key) == 1:
+                store.expire(key, lockout_seconds)
+        except CounterStoreError:
+            logger.warning("lockout count failed")
         return None
     return user
