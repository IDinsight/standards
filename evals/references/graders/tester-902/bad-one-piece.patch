+import json
+
+from app.extract.store import InvoiceStore
+from app.extract.stream import ExtractResult, extract_invoice
+
+RECORD = {"invoice_number": "INV-1042", "vendor": "Acme Tools", "total": 312.5}
+
+
+class FakeGateway:
+    """Stands in for GatewayClient.stream_message: yields the events given, in order."""
+
+    def __init__(self, events):
+        self.events = events
+
+    def stream_message(self, *, messages, tools, max_tokens):
+        yield from self.events
+
+
+def stream(pieces, *, stop_reason="tool_use", end=("message_delta", "message_stop")):
+    """An Anthropic-shaped event stream whose tool input arrives in the given pieces."""
+    events = [
+        {"type": "message_start", "message": {"id": "msg_1", "role": "assistant"}},
+        {"type": "content_block_start", "index": 0, "content_block": {"type": "tool_use", "id": "tu_1", "name": "record_invoice", "input": {}}},
+    ]
+    events += [{"type": "content_block_delta", "index": 0, "delta": {"type": "input_json_delta", "partial_json": p}} for p in pieces]
+    events.append({"type": "content_block_stop", "index": 0})
+    if "message_delta" in end:
+        events.append({"type": "message_delta", "delta": {"stop_reason": stop_reason}})
+    if "message_stop" in end:
+        events.append({"type": "message_stop"})
+    return events
+
+
+def split(record, parts=1):
+    text = json.dumps(record)
+    size = -(-len(text) // parts)
+    return [text[i:i + size] for i in range(0, len(text), size)]
+
+
+def run(events, tmp_path):
+    store = InvoiceStore(str(tmp_path / "invoices.db"))
+    result = extract_invoice("doc-7", "Invoice INV-1042 ...", client=FakeGateway(events), store=store)
+    return result, store.get_invoice("doc-7")
+
+
+def test_complete_stream_stores_the_record(tmp_path):
+    result, stored = run(stream(split(RECORD)), tmp_path)
+    assert result == ExtractResult("stored", RECORD)
+    assert stored == RECORD
+
+
+def test_error_event_stores_nothing(tmp_path):
+    events = stream(split(RECORD), end=())
+    events.append({"type": "error", "error": {"type": "overloaded_error", "message": "Overloaded"}})
+    result, stored = run(events, tmp_path)
+    assert result == ExtractResult("retryable", None)
+    assert stored is None
+
+
+def test_input_cut_off_at_max_tokens_stores_nothing(tmp_path):
+    result, stored = run(stream(['{"invoice_number": "INV-10'], stop_reason="max_tokens"), tmp_path)
+    assert result.record is None and result.status != "stored"
+    assert stored is None
+
+
+def test_input_that_is_not_json_stores_nothing(tmp_path):
+    result, stored = run(stream(['{"invoice_number": "INV-1042", "vendor": ']), tmp_path)
+    assert result.record is None and result.status != "stored"
+    assert stored is None
