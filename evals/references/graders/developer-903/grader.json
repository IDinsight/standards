{
  "label": "D3",
  "reference": "skills/developer/references/github-actions-python.md",
  "checks": [
    {
      "id": "matrix-python",
      "tier": "outcome",
      "text": "The tests run on each of Python 3.11, 3.12, and 3.13 (a matrix or separate jobs), each run on its own version (for example UV_PYTHON in the job or step env, --python on the uv command that runs the tests, uv python pin, or setup-uv's python-version input). Installing the version alone (setup-python or uv python install) fails, because .python-version still selects 3.12."
    },
    {
      "id": "coverage-always",
      "tier": "outcome",
      "text": "The coverage report upload runs even when the tests fail (if: always(), or another condition that holds on failure)."
    },
    {
      "id": "artifact-names",
      "tier": "outcome",
      "text": "Each matrix leg uploads its coverage report under its own artifact name."
    },
    {
      "id": "no-threshold",
      "tier": "outcome",
      "text": "The workflow runs the apps/api tests with coverage and sets no coverage threshold (no --cov-fail-under and no fail_under)."
    },
    {
      "id": "setup-points-at-service",
      "tier": "reference",
      "text": "The setup steps point at apps/api (for example setup-uv's working-directory or cache-dependency-glob), not only the run steps."
    },
    {
      "id": "test-timeout-15",
      "tier": "reference",
      "text": "The test job's timeout is 15 minutes."
    },
    {
      "id": "commands-in-service",
      "tier": "control",
      "text": "Each of the five commands from the design runs in apps/api."
    },
    {
      "id": "triggers-main",
      "tier": "control",
      "text": "The workflow runs on pushes and pull requests to main."
    },
    {
      "id": "paths-filters",
      "tier": "control",
      "text": "The triggers are filtered to changes under apps/api and packages/shared."
    },
    {
      "id": "fail-fast-false",
      "tier": "control",
      "text": "The matrix sets fail-fast: false."
    },
    {
      "id": "frozen-sync",
      "tier": "control",
      "text": "Dependencies install with uv sync --frozen or --locked."
    },
    {
      "id": "read-only-permissions",
      "tier": "control",
      "text": "The workflow's permissions are read-only."
    },
    {
      "id": "job-timeouts",
      "tier": "control",
      "text": "Every job sets timeout-minutes."
    },
    {
      "id": "retention-days",
      "tier": "control",
      "text": "Every uploaded artifact sets retention-days."
    },
    {
      "id": "dependency-cache",
      "tier": "control",
      "text": "uv's cache is enabled and keyed on the lockfile (setup-uv's enable-cache, or a cache keyed on apps/api/uv.lock)."
    }
  ],
  "rules": [
    {
      "check": "matrix-python",
      "file": "skills/developer/references/github-actions-python.md",
      "text": "# Overrides .python-version so each leg really uses its version."
    },
    {
      "check": "matrix-python",
      "file": "skills/developer/references/github-actions-python.md",
      "text": "use it when `.python-version` pins another version; set `UV_PYTHON` or pass"
    },
    {
      "check": "coverage-always",
      "file": "skills/developer/references/github-actions-python.md",
      "text": "if: always() # keep the report even when tests fail"
    },
    {
      "check": "no-threshold",
      "file": "skills/developer/references/github-actions-python.md",
      "text": "Fail the build on a threshold only when the project has established one."
    },
    {
      "check": "no-threshold",
      "file": "skills/developer/references/github-actions-python.md",
      "text": "# Add --cov-fail-under=<threshold> only when one is established."
    },
    {
      "check": "setup-points-at-service",
      "file": "skills/developer/references/github-actions-python.md",
      "text": "`defaults.run` applies only to `run:` steps. Point setup actions at the service"
    },
    {
      "check": "test-timeout-15",
      "file": "skills/developer/references/github-actions-python.md",
      "text": "check, and build; 15 for tests; 30 for deployment. Adjust from real durations."
    }
  ],
