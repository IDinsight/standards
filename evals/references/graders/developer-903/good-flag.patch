diff --git a/.github/workflows/api-ci.yml b/.github/workflows/api-ci.yml
new file mode 100644
index 0000000..d05c88e
--- /dev/null
+++ b/.github/workflows/api-ci.yml
@@ -0,0 +1,44 @@
+name: API CI
+on:
+  push:
+    branches: [main]
+    paths: ["apps/api/**", "packages/shared/**"]
+  pull_request:
+    branches: [main]
+    paths: ["apps/api/**", "packages/shared/**"]
+permissions:
+  contents: read
+jobs:
+  checks:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+        with:
+          working-directory: apps/api
+          enable-cache: true
+      - run: cd apps/api && uv sync --locked && uv run ruff check . && uv run ruff format --check . && uv run mypy app && uv build
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    strategy:
+      fail-fast: false
+      matrix:
+        py: ["3.11", "3.12", "3.13"]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+        with:
+          working-directory: apps/api
+          enable-cache: true
+      - working-directory: apps/api
+        run: |
+          uv sync --locked --python ${{ matrix.py }}
+          uv run --locked --python "${{ matrix.py }}" pytest --cov=app --cov-report=xml
+      - if: ${{ !cancelled() }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: coverage-py${{ matrix.py }}
+          path: apps/api/coverage.xml
+          retention-days: 7
