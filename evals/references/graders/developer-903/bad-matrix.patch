diff --git a/.github/workflows/api-ci.yml b/.github/workflows/api-ci.yml
new file mode 100644
index 0000000..21bb78d
--- /dev/null
+++ b/.github/workflows/api-ci.yml
@@ -0,0 +1,52 @@
+name: API CI
+on:
+  push:
+    branches: [main]
+    paths: ["apps/api/**", "packages/shared/**"]
+  pull_request:
+    branches: [main]
+    paths: ["apps/api/**", "packages/shared/**"]
+permissions:
+  contents: read
+defaults:
+  run:
+    working-directory: apps/api
+jobs:
+  lint:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+        with:
+          enable-cache: true
+          cache-dependency-glob: apps/api/uv.lock
+      - run: uv sync --frozen
+      - run: uv run ruff check .
+      - run: uv run ruff format --check .
+      - run: uv run mypy app
+      - run: uv build
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    strategy:
+      fail-fast: false
+      matrix:
+        python-version: ["3.11", "3.12", "3.13"]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+          cache-dependency-path: apps/api/uv.lock
+      - uses: astral-sh/setup-uv@v6
+        with:
+          enable-cache: true
+          cache-dependency-glob: apps/api/uv.lock
+      - run: uv sync --frozen
+      - run: uv run pytest --cov=app --cov-report=xml --cov-fail-under=80
+      - uses: actions/upload-artifact@v4
+        with:
+          name: coverage-report
+          path: apps/api/coverage.xml
+          retention-days: 7
