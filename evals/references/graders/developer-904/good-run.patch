diff --git a/.github/workflows/notify.yml b/.github/workflows/notify.yml
new file mode 100644
index 0000000..95087da
--- /dev/null
+++ b/.github/workflows/notify.yml
@@ -0,0 +1,19 @@
+name: CI failure notice
+on:
+  workflow_run:
+    workflows: [CI]
+    types: [completed]
+permissions:
+  contents: read
+jobs:
+  notify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    if: github.event.workflow_run.conclusion == 'failure' && github.event.workflow_run.head_branch == 'main' && github.event.workflow_run.event == 'push'
+    steps:
+      - uses: slackapi/slack-github-action@v2
+        with:
+          webhook: ${{ secrets.SLACK_WEBHOOK_URL }}
+          webhook-type: incoming-webhook
+          payload: |
+            {"text": "CI failed on main: ${{ github.event.workflow_run.html_url }}"}
diff --git a/.github/workflows/security.yml b/.github/workflows/security.yml
new file mode 100644
index 0000000..ff93ae4
--- /dev/null
+++ b/.github/workflows/security.yml
@@ -0,0 +1,17 @@
+name: Security
+on:
+  pull_request:
+    branches: [main]
+  schedule:
+    - cron: "30 5 * * 0"
+permissions:
+  contents: read
+jobs:
+  audit:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+      - run: uv export --frozen --format requirements-txt --no-hashes -o requirements-audit.txt
+      - run: uvx pip-audit -r requirements-audit.txt
