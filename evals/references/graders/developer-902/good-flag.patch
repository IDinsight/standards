index 0000000..6894de7
--- /dev/null
+++ b/app/utils/security_headers.py
@@ -0,0 +1,37 @@
+"""Baseline browser security headers on every response."""
+
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+BASELINE_HEADERS = {
+    "cache-control": "no-store",
+    "permissions-policy": "geolocation=(), camera=(), microphone=()",
+    "referrer-policy": "strict-origin-when-cross-origin",
+    "x-content-type-options": "nosniff",
+    "x-frame-options": "DENY",
+}
+HSTS_VALUE = "max-age=31536000"
+
+
+def security_headers(*, hsts: bool) -> dict[str, str]:
+    headers = dict(BASELINE_HEADERS)
+    if hsts:
+        headers["strict-transport-security"] = HSTS_VALUE
+    return headers
+
+
+class SecurityHeadersMiddleware:
+    def __init__(self, app: ASGIApp, *, hsts: bool) -> None:
+        self.app = app
+        self.headers = [(k.encode("latin-1"), v.encode("latin-1")) for k, v in security_headers(hsts=hsts).items()]
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        async def send_with_headers(message: Message) -> None:
+            if message["type"] == "http.response.start":
+                message = {**message, "headers": [*message.get("headers", []), *self.headers]}
+            await send(message)
+
+        await self.app(scope, receive, send_with_headers)
