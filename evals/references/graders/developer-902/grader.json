{
  "label": "D2",
  "reference": "skills/developer/references/security-fastapi.md",
  "checks": [
    {
      "id": "nosniff",
      "tier": "outcome",
      "text": "Every API response carries X-Content-Type-Options: nosniff."
    },
    {
      "id": "framing-denied",
      "tier": "outcome",
      "text": "Every API response denies framing: X-Frame-Options: DENY, or a Content-Security-Policy with frame-ancestors 'none'."
    },
    {
      "id": "xss-auditor-off",
      "tier": "outcome",
      "atStart": "pass",
      "text": "No response turns on the legacy XSS auditor: X-XSS-Protection is absent or 0."
    },
    {
      "id": "no-store",
      "tier": "outcome",
      "text": "API responses carry Cache-Control: no-store by default."
    },
    {
      "id": "no-server-header",
      "tier": "outcome",
      "text": "The Dockerfile's start command runs uvicorn without its server header: --no-server-header, or server_header=False where the start command reaches uvicorn.run or uvicorn.Config."
    },
    {
      "id": "wraps-cors",
      "tier": "outcome",
      "text": "The security-headers middleware wraps CORSMiddleware (added after it with add_middleware, or listed before it in FastAPI(middleware=[...])), so its headers also reach CORS preflight responses."
    },
    {
      "id": "referrer-policy",
      "tier": "reference",
      "text": "Referrer-Policy is strict-origin-when-cross-origin."
    },
    {
      "id": "permissions-policy",
      "tier": "reference",
      "text": "A Permissions-Policy header is set."
    },
    {
      "id": "hsts-production-only",
      "tier": "reference",
      "text": "Strict-Transport-Security is set, and only when settings.environment is production."
    },
    {
      "id": "middleware-module",
      "tier": "control",
      "text": "app/utils/security_headers.py defines the middleware, and app/main.py registers it."
    }
  ],
  "rules": [
    {
      "check": "nosniff",
      "file": "skills/developer/references/security-fastapi.md",
      "text": "headers[\"X-Content-Type-Options\"] = \"nosniff\""
    },
    {
      "check": "framing-denied",
      "file": "skills/developer/references/security-fastapi.md",
      "text": "headers[\"X-Frame-Options\"] = \"DENY\""
    },
    {
      "check": "xss-auditor-off",
      "file": "skills/developer/references/security-fastapi.md",
      "text": "headers[\"X-XSS-Protection\"] = \"0\""
    },
    {
      "check": "no-store",
