    },
    {
      "check": "no-server-header",
      "file": "skills/developer/references/security-fastapi.md",
      "text": "`--no-server-header` instead of trying to delete it in middleware."
    },
    {
      "check": "wraps-cors",
      "file": "skills/developer/references/security-fastapi.md",
      "text": "Register it in `app/main.py` after the CORS middleware, which makes it the"
    },
    {
      "check": "referrer-policy",
      "file": "skills/developer/references/security-fastapi.md",
      "text": "headers[\"Referrer-Policy\"] = \"strict-origin-when-cross-origin\""
    },
    {
      "check": "permissions-policy",
      "file": "skills/developer/references/security-fastapi.md",
