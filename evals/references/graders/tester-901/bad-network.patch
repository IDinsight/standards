--- /dev/null
+++ b/tests/test_summary_service.py
@@ -0,0 +1,70 @@
+import pytest
+
+from app.llm.types import Completion, RateLimitError
+from app.summaries.service import UNAVAILABLE, SummaryJob, run_summary_job
+
+
+class FakeClient:
+    """Stands in for LLMClient: returns or raises what the real client does."""
+
+    def __init__(self, outcome):
+        self.outcome = outcome
+        self.calls = []
+
+    def complete(self, messages, *, max_tokens):
+        self.calls.append(max_tokens)
+        if isinstance(self.outcome, Exception):
+            raise self.outcome
+        return self.outcome
+
+
+class Tickets:
+    def get_text(self, ticket_id):
+        return f"Ticket {ticket_id}: the export button does nothing."
+
+
+class Store:
+    def __init__(self):
+        self.saved = []
+
+    def save_summary(self, ticket_id, text):
+        self.saved.append((ticket_id, text))
+
+
+class Scheduler:
+    def __init__(self):
+        self.scheduled = []
+
+    def schedule(self, job, *, delay_seconds):
+        self.scheduled.append((job, delay_seconds))
+
+
+def run(outcome, max_tokens=400):
+    store, scheduler = Store(), Scheduler()
+    run_summary_job(SummaryJob(7, max_tokens), client=FakeClient(outcome), tickets=Tickets(), store=store, scheduler=scheduler)
+    return store.saved, scheduler.scheduled
+
+
+def test_normal_completion_is_stored():
+    saved, scheduled = run(Completion(text="Export fails silently.", finish_reason="stop", refusal=None))
+    assert saved == [(7, "Export fails silently.")]
+    assert scheduled == []
+
+
+def test_cut_off_completion_is_retried_with_a_larger_limit():
+    saved, scheduled = run(Completion(text="Export fails sil", finish_reason="length", refusal=None))
+    assert saved == []
+    assert scheduled == [(SummaryJob(7, 800), 0)]
+
+
+def test_refusal_is_stored_as_unavailable():
+    saved, scheduled = run(Completion(text=None, finish_reason="stop", refusal="I can't help with that."))
+    assert saved == [(7, UNAVAILABLE)]
+    assert scheduled == []
+
+
+@pytest.mark.parametrize("retry_after", [12.0])
+def test_rate_limit_reschedules_after_retry_after(retry_after):
+    saved, scheduled = run(RateLimitError(retry_after))
+    assert saved == []
+    assert scheduled == [(SummaryJob(7, 400), retry_after)]
