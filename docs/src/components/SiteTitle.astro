---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="standards-title" translate="no">
  <a class="brand" href={siteTitleHref}>{siteTitle}</a>
  <a class="credit" href="https://www.idinsight.org/">
    <span class="separator" aria-hidden="true">- </span>Built by <strong>IDinsight</strong>
  </a>
</div>

<style>
  .standards-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    line-height: 1.25;
  }

  .brand {
    color: var(--sl-color-text-accent);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.025em;
    text-decoration: none;
    white-space: nowrap;
  }

  .credit {
    color: var(--standards-credit);
    font-size: 0.8125rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .credit:hover {
    text-decoration: underline;
  }

  @media (max-width: 63.99rem) {
    .standards-title {
      flex-direction: column;
      gap: 0.125rem;
    }

    .separator {
      display: none;
    }
  }
</style>
