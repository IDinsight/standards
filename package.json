{
	"bin": {
		"standards": "./bin/standards.js"
	},
	"dependencies": {
		"@clack/prompts": "1.8.1"
	},
	"description": "S.T.A.N.D.A.R.D.S. framework installer for coding agents",
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"bin/",
		"lib/",
		"PROTOCOL.md",
		"runtime/",
		"skills/",
		"!skills/*/evals/",
		"templates/"
	],
	"license": "MIT",
	"name": "@idinsight/standards",
	"packageManager": "pnpm@10.34.5",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IDinsight/standards.git"
	},
	"scripts": {
		"check:release": "node scripts/check-release.mjs",
		"docs:dev": "pnpm --filter standards-docs run dev",
		"docs:build": "pnpm --filter standards-docs run build",
		"docs:check-links": "pnpm --filter standards-docs run check-links",
		"docs:preview": "pnpm --filter standards-docs run preview",
		"docs:sync-reference": "pnpm --filter standards-docs run sync-reference",
		"test": "node --test \"test/*.test.js\"",
		"test:cli": "node --test test/cli.test.js",
		"test:installer": "node --test test/installer.test.js test/reset.test.js test/uninstaller.test.js",
		"test:package": "node test/packed-install.test.js",
		"test:runtime": "node --test test/runtime.test.js",
		"test:release": "node --test test/release.test.js"
	},
	"type": "module",
	"version": "0.5.0"
}
