# Settings for the eval harness in evals/ (pnpm evals ...). Copy this file to .env in
# the repository root (gitignored) and paste your key below. Only ANTHROPIC_API_KEY is
# required. The EVAL_* lines set what the evals use; a line you delete falls back to
# its default in evals/harness/lib/config.mjs. A variable set in your shell overrides
# this file.

# Anthropic API key. It's used for the model under test, the judge, and fixture
# generation and review. The harness passes it only to the SDK and to each run's
# container, and redacts it from saved results.
ANTHROPIC_API_KEY=

# Framework release under test: a tag, branch, or commit in this checkout.
EVAL_COMMIT=v0.15.0

# Claude Code version baked into the runner image. Changing it means
# `pnpm evals image build` again.
EVAL_CLAUDE_CODE_VERSION=2.1.283

# Model under test, run through Claude Code inside Docker.
EVAL_EFFORT=high
EVAL_MODEL=claude-sonnet-5-5

# Judge for assertions that exact checks cannot decide.
EVAL_JUDGE_EFFORT=high
EVAL_JUDGE_MODEL=claude-opus-5-5

# Second judge for the reliability check: re-grades a sample of verdicts. It must
# differ from the judge; "none" skips that check.
EVAL_SECOND_JUDGE_EFFORT=medium
EVAL_SECOND_JUDGE_MODEL=claude-fable-5-1

# Fixture generation and review (gate 3).
EVAL_FIXTURE_EFFORT=high
EVAL_GEN_MODEL=claude-opus-5-5
EVAL_REVIEW_MODEL=claude-opus-5-5
